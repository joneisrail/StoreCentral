# Copy to deploy/.env and fill in. Names only: this file holds no secrets.
# Generate each secret yourself (for example `openssl rand -hex 32`), never
# reuse a value from another environment, and never commit deploy/.env.
# Secrets must be at least 32 characters where deploy/check-env.mjs says so.
# Use hex or base64url so database and Redis passwords need no URL escaping
# (they are placed inside connection URLs).

# Public host names, one per site (DNS must point at this server).
STORE_HOST=
ADMIN_HOST=
POS_HOST=
# Public webhook host of seller-hub. Only /webhooks/* is reachable on it.
HUB_HOST=

# Postgres. POSTGRES_USER and POSTGRES_DB have non-secret defaults.
POSTGRES_USER=postgres
POSTGRES_DB=storecentral
POSTGRES_PASSWORD=
MEDUSA_DB_PASSWORD=
SELLER_HUB_DB_PASSWORD=

# Redis
REDIS_PASSWORD=

# Backend (Medusa)
# The compose file connects the backend to Postgres with sslmode=disable because
# vendored Medusa forces SSL for non-localhost URLs; traffic stays on the
# private compose network, so no database SSL settings are needed here.
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
# One value that feeds both backend and seller-hub, so they always match.
SELLER_HUB_INTERNAL_SECRET=
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
EASYPOST_DEFAULT_PARCEL_WEIGHT=
EASYPOST_DEFAULT_PARCEL_LENGTH=
EASYPOST_DEFAULT_PARCEL_WIDTH=
EASYPOST_DEFAULT_PARCEL_HEIGHT=

# seller-hub
# Medusa admin user that seller-hub signs in as.
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
# 64 hex characters. Rotating it makes stored marketplace credentials unreadable.
ENCRYPTION_KEY=
# The Amazon values below are all optional; normally they are entered on
# Settings, Amazon (the secrets AWS access key id, AWS secret access key and LWA
# client secret are stored encrypted in seller-hub; region, queue URL and LWA
# client id are stored as plain text; the stored value wins).
# If set here they act as a per-field fallback. Leave empty rather than using
# placeholder text.
AWS_REGION=
SQS_QUEUE_URL=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
# Optional; normally entered on Settings, Amazon (or use an instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Storefront. NEXT_PUBLIC_* values are baked into the image at build time;
# after changing one, run: docker compose -f deploy/docker-compose.yml build storefront
# Public URL of the backend as seen by browsers, for example https://<ADMIN_HOST>.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Public URL of the storefront, for example https://<STORE_HOST>.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_DEFAULT_REGION=
NEXT_PUBLIC_STRIPE_KEY=
