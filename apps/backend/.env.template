STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend
# DB_HOST/DB_USERNAME/DB_PASSWORD/DB_PORT are only read by
# @medusajs/test-utils's HTTP integration test runner (integration-tests/http),
# which builds its own throwaway per-test-database connection string from
# these instead of DATABASE_URL. Put real local values in .env.test
# (gitignored), not here.
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_PORT=
# Base URL of seller-hub's webhook receiver (apps/seller-hub/src/webhook/server.ts),
# used by src/subscribers/seller-hub-sync.ts to forward inventory/price change events.
SELLER_HUB_WEBHOOK_URL=http://localhost:7005
# seller-hub's authenticated internal API (/internal/connections), used by the
# admin marketplace-connections routes. The secret must equal seller-hub's
# SELLER_HUB_INTERNAL_SECRET.
SELLER_HUB_INTERNAL_URL=http://localhost:7005
SELLER_HUB_INTERNAL_SECRET=

# EasyPost fulfillment provider (@dtc/fulfillment-easypost), registered in
# medusa-config.ts. EASYPOST_API_KEY is the account's API key (test or
# production mode key, EasyPost distinguishes by prefix). EASYPOST_WEBHOOK_SECRET
# is read directly by the webhook route, not passed through module options.
# EASYPOST_DEFAULT_PARCEL_* set the fallback parcel dimensions (ounces/inches)
# used when a cart's line items don't supply enough weight/dimension data.
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
EASYPOST_DEFAULT_PARCEL_WEIGHT=16
EASYPOST_DEFAULT_PARCEL_LENGTH=10
EASYPOST_DEFAULT_PARCEL_WIDTH=8
EASYPOST_DEFAULT_PARCEL_HEIGHT=4
