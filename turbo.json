{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".medusa/**"]
    },
    "build:plugin": {
      "dependsOn": ["^build", "@medusajs/medusa#build"],
      "outputs": ["!node_modules/**", "!src/**", ".medusa/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "outputs": []
    },
    "test:integration:chunk": {
      "outputs": []
    },
    "seed": {
      "outputs": []
    }
  },
  "globalDependencies": ["turbo.json"]
}
